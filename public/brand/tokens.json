{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "soot-950": { "$value": "#171512", "$type": "color" },
    "soot-800": { "$value": "#2B2721", "$type": "color" },
    "parchment-100": { "$value": "#F4E7C5", "$type": "color" },
    "parchment-50": { "$value": "#FFF8E8", "$type": "color" },
    "ale-gold-500": { "$value": "#D9A441", "$type": "color" },
    "dumpster-green-500": { "$value": "#4F7A57", "$type": "color" },
    "ember-500": { "$value": "#C85A3A", "$type": "color" },
    "ink-900": { "$value": "#211D18", "$type": "color" }
  },
  "font": {
    "body": { "$value": "Atkinson Hyperlegible, Arial, sans-serif", "$type": "fontFamily" },
    "display": { "$value": "Spectral, Georgia, serif", "$type": "fontFamily" }
  },
  "space": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" }
  },
  "semantic": {
    "page-background": { "$value": "{color.soot-950}", "$type": "color" },
    "surface-dark": { "$value": "{color.soot-800}", "$type": "color" },
    "surface-light": { "$value": "{color.parchment-50}", "$type": "color" },
    "text-on-dark": { "$value": "{color.parchment-100}", "$type": "color" },
    "text-on-light": { "$value": "{color.ink-900}", "$type": "color" },
    "action-primary": { "$value": "{color.ale-gold-500}", "$type": "color" },
    "focus-ring": { "$value": "{color.ale-gold-500}", "$type": "color" },
    "warning-background": { "$value": "{color.parchment-50}", "$type": "color" },
    "warning-foreground": { "$value": "{color.ink-900}", "$type": "color" },
    "warning-border-nontext": { "$value": "{color.ember-500}", "$type": "color" }
  }
}

---
interface Item { href:string; title:string; summary:string; image?:string; badge?:string; }
interface Props { items:Item[]; label:string; }
const { items, label } = Astro.props;
---
<div class="cards" aria-label={label}>{items.map((item,i)=><article class="card">{item.image&&<img src={item.image} width="600" height="420" loading={i===0?'eager':'lazy'} alt="">}<div class="card-body">{item.badge&&<p class="tag">{item.badge}</p>}<h3><a href={item.href}>{item.title}</a></h3><p>{item.summary}</p></div></article>)}</div>

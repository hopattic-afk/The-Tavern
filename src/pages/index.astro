---
import Base from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import DisabledForm from '../components/DisabledForm.astro'; import StatusNotice from '../components/StatusNotice.astro'; import { notices,disclaimer } from '../data/site';
---
<Base title="Bad plans. Strong rallies." description="The pre-launch Tavern site: original feral trash-panda stories and high-end wearable merchandise concepts." image="/images/steve-hero-1536.webp"><Hero title="The Tavern" copy="A rain-dark refuge for strong rallies, questionable plans and feral trash-panda comedy."><a class="button" href="/trash-pandas/">Meet Steve</a><a class="button secondary" href="/shop/">See the merch direction</a></Hero><section class="section intro-grid"><div><p class="eyebrow">The house rule</p><h2>Raccoons only. Keep them scrappy.</h2></div><p class="lede">No human imagery. No polished court. The Tavern belongs to wary, weathered trash pandas using whatever they can salvage to keep the lights on.</p></section><section class="section feature"><div><p class="eyebrow">Meet the mascot</p><h2>Steve runs the Tavern.</h2><p class="lede">Steve is practical, suspicious and a little feral. He wears battered work gear, not armor, and would rather repair a stool than pose on a throne.</p><p><a class="button" href="/trash-pandas/bramble-bung/">Meet Steve</a></p></div><picture><source type="image/webp" srcset="/images/steve-hero-640.webp 640w, /images/steve-hero-960.webp 960w, /images/steve-hero-1536.webp 1536w" sizes="(max-width: 760px) 100vw, 50vw"><img src="/images/steve-hero-960.webp" width="1536" height="864" loading="lazy" alt="Steve, a feral raccoon innkeeper in a wet Tavern alley"></picture></section><section class="section merch-feature"><picture><source type="image/webp" srcset="/images/merch-direction-640.webp 640w, /images/merch-direction-960.webp 960w, /images/merch-direction-1536.webp 1536w" sizes="(max-width: 760px) 100vw, 50vw"><img src="/images/merch-direction-960.webp" width="1536" height="864" loading="lazy" alt="Premium black Tavern shirt and hoodie with restrained gold tankard marks"></picture><div><p class="eyebrow">Wearable, not promotional</p><h2>Quiet on the front. Back concept comes next.</h2><p class="lede">The selected system pairs a restrained front identifier with one considered Tavern-related back composition. This pre-launch mockup validates the front treatment only; back artwork and commercial clearance remain pending.</p><p><a class="button" href="/shop/">Review Drop 01</a></p></div></section><section class="section"><h2>Pre-launch noticeboard</h2>{notices.map(n=><StatusNotice title={n}><p>No sale, submission, analytics or social publishing is active.</p></StatusNotice>)}</section><section class="section"><DisabledForm kind="email"/><p><a href="/submit/">Read the disabled incident-intake notice</a></p><p>Social accounts are not connected.</p><p class="disclaimer-box">{disclaimer}</p></section></Base>

---
import Base from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import Cards from '../components/Cards.astro'; import DisabledForm from '../components/DisabledForm.astro'; import StatusNotice from '../components/StatusNotice.astro'; import { products,tales,notices,disclaimer } from '../data/site';
---
<Base title="Bad plans. Strong rallies." description="Enter a provisional medieval trash-panda tavern for original characters, comedy and merchandise concepts."><Hero title="The Tavern" copy="A crooked refuge for strong rallies, questionable leadership and original trash-panda comedy."><a class="button" href="/tavern-tales/">Watch Tavern Tales</a><a class="button secondary" href="/trash-pandas/">Meet the Trash Pandas</a></Hero><section class="section"><p class="eyebrow">What is this place?</p><h2>Community comedy, built from scratch</h2><p class="lede">The Tavern is an original, unofficial player-community project. The brand system, cast and storefront remain provisional.</p></section><section class="section"><h2>Provisional merchandise</h2><Cards label="Featured merchandise" items={products.map(p=>({href:`/shop/${p.slug}/`,title:p.name,summary:p.summary,image:p.image,badge:'Not for sale'}))}/><p><a class="button" href="/shop/">Enter the shop</a></p></section><section class="section"><h2>Featured character</h2><Cards label="Featured character" items={[{href:'/trash-pandas/bramble-bung/',title:'Bramble Bung',summary:'The exhausted innkeeper and provisional mascot candidate.',image:'/characters/bramble-bung.svg',badge:'Founder approval pending'}]}/></section><section class="section"><h2>Latest Tavern Tales</h2><Cards label="Latest tales" items={tales.map(t=>({href:`/tavern-tales/${t.slug}/`,title:t.title,summary:t.summary,badge:'Concept only'}))}/></section><section class="section"><h2>Tavern noticeboard</h2>{notices.map(n=><StatusNotice title={n}><p>No action is being taken until its approval gate is recorded.</p></StatusNotice>)}</section><section class="section"><DisabledForm kind="email"/><p><a href="/submit/">Read the disabled incident-intake notice</a></p><p>Social accounts are not connected.</p><p class="disclaimer-box">{disclaimer}</p></section></Base>

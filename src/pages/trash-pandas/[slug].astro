---
import Base from '../../layouts/BaseLayout.astro'; import PageIntro from '../../components/PageIntro.astro'; import Status from '../../components/StatusNotice.astro'; import data from '../../../content/characters/characters.json'; export function getStaticPaths(){return data.characters.map(character=>({params:{slug:character.id},props:{character}}));} const {character}=Astro.props;
---
<Base title={character.name} description={`${character.role}: ${character.personality}.`}><article class="section"><PageIntro title={character.name} eyebrow="Provisional character" copy={`${character.role}: ${character.personality}.`}/><img src={`/characters/${character.id}.svg`} width="760" height="760" alt={`Provisional original illustration of ${character.name}, the ${character.role}`}><Status title="Founder approval pending"><p>This character cannot enter public or commercial production until name, similarity, privacy and rights reviews are complete.</p></Status><div class="prose"><h2>At a glance</h2><dl><dt>Silhouette</dt><dd>{character.silhouette}</dd><dt>Strength</dt><dd>{character.strength}</dd><dt>Weakness</dt><dd>{character.weakness}</dd><dt>Recurring prop</dt><dd>{character.prop}</dd><dt>Catchphrase</dt><dd>“{character.catchphrase}”</dd></dl><h2>Concepts</h2><ul>{character.skits.map((s:string)=><li>{s}</li>)}</ul></div></article></Base>
